{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PLC OS",
  "version": "0.1.0",
  "identifier": "xyz.plcapital.plcos",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "resources": { "../core/": "core/" },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
