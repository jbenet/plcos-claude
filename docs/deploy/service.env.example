# Capital OS service environment (rev 3, docs/deploy/rev3.md). NAMES ONLY: never put a value in
# this file or in git. Values go in the LabOS secrets page, or PL's secrets store if they have one.
#
# The comment line above each name starts with its tag. scripts/preflight.sh reads these tags,
# and a property checks that every variable the service code reads is listed here.
#   [required]       must be set from the first (demo) boot
#   [required-real]  must be set once DATA_PROFILE=real
#   [later]          leave unset at cutover; turn on afterwards (see the note)
#   [optional]       has a working default
#   [image]          the Dockerfile sets it; do not enter it
#   [internal]       the code or Next sets it for itself; do not enter it
#   [never]          must stay UNSET on the service (Mac-only, or would break a boundary)
# "secret" marks a value that must never be logged, pasted in chat, or put in a URL.

## Identity of the server

# [required] demo for the first boot against an empty database, then real at cutover.
DATA_PROFILE=
# [required] LabOS /me endpoint. Turns on LabOS sign-in and marks this process as the live server
# (F3). From the LabOS kit.
LABOS_ME_URL=

## Database (PL's provisioned Postgres, or local Postgres on the VM fallback)

# [required] postgres://<user>@<host>:5432/<db>, with NO password in it. From the kit.
DATABASE_URL=
# [optional] secret. The database password, if the kit does not hand it over another way. The name
# the kit uses is a question for PL; libpq tools (pg_dump, psql) and node-postgres both read PGPASSWORD.
PGPASSWORD=
# [optional] Set to verify-full when the database is not on loopback. The server verifies TLS by
# itself; this makes pg_dump and psql (backup, cutover) verify it too. Preflight fails without it
# for a remote database.
PGSSLMODE=

## Connector keys (read-only connectors; the Mac copies stay in the Keychain)

# [required-real] secret. Affinity API key. Copy of Keychain item plcos-affinity (npm run key:store).
AFFINITY_API_KEY=
# [required-real] secret. Linear personal key. Copy of Keychain item plcos-linear / api-key.
LINEAR_API_KEY=
# [never] Dakota stays on the Mac (rev 3 decision 3). Setting these on the service would let it sync.
DAKOTA_USERNAME=
# [never] See DAKOTA_USERNAME.
DAKOTA_PASSWORD=
# [never] Warehouse (Polaris) queries run from the Mac with Juan's gcloud login, not from the service.
CLOUDSDK_AUTH_ACCESS_TOKEN=

## Research workflows (W1, W1c, W5 buttons)

# [later] secret. Anthropic key from a workspace with a monthly spend limit set in the console
# (rev 3 decision 2: $1,500 a month, a GUESS). Without it the buttons refuse; nothing else changes.
ANTHROPIC_API_KEY=
# [optional] Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=

## Feedback export (the Mac dev session pulls new issues)

# [required-real] secret. A random token (for example `openssl rand -hex 32`), also stored on the
# Mac with npm run secret:store. Unset means GET /api/feedback/export answers 404.
FEEDBACK_EXPORT_TOKEN=

## Daily work and backups

# [later] HH:MM in UTC, for example 03:00. Leave unset on cutover day; set it once a manual Affinity
# sync has worked from the container (runbook §1).
SCHEDULE_DAILY_AT=
# [required-real] Exactly: bash scripts/backup-service.sh
BACKUP_COMMAND=
# [required-real] The S3 bucket PL provides. AWS access comes from the service's role, not keys.
BACKUP_BUCKET=
# [required-real] Armored GPG PUBLIC key text (not secret). The private half stays offline with Juan.
BACKUP_GPG_PUBLIC_KEY=
# [optional] Region for the AWS CLI, if the role does not supply one. From PL.
AWS_REGION=
# [optional] 1 = dump, verify and encrypt, print the S3 actions, make no AWS call.
BACKUP_DRY_RUN=
# [optional] With BACKUP_DRY_RUN=1: keep the encrypted files in this directory (the restore drill).
BACKUP_KEEP_DIR=

## Set by the image (Dockerfile)

# [image] production
NODE_ENV=
# [image] .next (F1)
NEXT_DIST_DIR=
# [image] 8080 unless the kit overrides it.
PORT=
# [image] The RDS CA bundle, for node.
NODE_EXTRA_CA_CERTS=
# [image] The RDS CA bundle, for libpq.
PGSSLROOTCERT=
# [image] The commit the image was built from.
GIT_COMMIT=

## Set by the code itself

# [internal] Set to 1 in the import child process only.
PLCOS_IMPORT_WORKER=
# [internal] Generated per process when unset.
PLCOS_INTERNAL_ROUTING_KEY=
# [internal] Next.js.
NEXT_RUNTIME=
# [internal] Next.js.
NEXT_PHASE=

## Mac development only

# [never] Rehearsal on a copy (docs/21-postgres.md).
POSTGRES_REHEARSAL=
# [never] Preview of a real-data copy (docs/COLLAB.md).
PREVIEW_COPY_AT=
# [never] Demo PGlite folder.
PGLITE_DIR=
# [never] Research export folder override, for tests.
ENRICH_DIR=
