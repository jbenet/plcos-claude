# Capital OS service environment (rev 3, docs/deploy/rev3.md; Railway, docs/deploy/railway.md). NAMES ONLY:
# never put a value in this file or in git. On Railway only two values live outside the app: PLCOS_SECRET and
# the database connection. The keys, the Google sign-in client and the tokens are entered in the app (/setup,
# then Settings → Connections) and kept encrypted with PLCOS_SECRET; a variable set here still wins over them.
#
# The comment line above each name starts with its tag. scripts/preflight.sh reads these tags,
# and a property checks that every variable the service code reads is listed here.
#   [required]       must be set from the first (demo) boot
#   [required-real]  must be set once DATA_PROFILE=real
#   [later]          leave unset at cutover; turn on afterwards (see the note)
#   [optional]       has a working default
#   [image]          the Dockerfile sets it; do not enter it
#   [internal]       the code or Next sets it for itself; do not enter it
#   [never]          must stay UNSET on the service (Mac-only, or would break a boundary)
#   [platform]       the hosting platform (Railway) sets it; do not enter it
# "secret" marks a value that must never be logged, pasted in chat, or put in a URL.

## Identity of the server

# [required] demo for the first boot against an empty database, then real at cutover.
DATA_PROFILE=
# [optional] LabOS /me endpoint, for the LabOS deployment only (rev 3). Turns on LabOS sign-in and marks this
# process as the live server (F3). Unset on Railway, which signs people in with Google.
LABOS_ME_URL=
# [required] secret. 32+ random bytes, base64 (openssl rand -base64 32). Encrypts the settings kept in the app
# and signs sessions. Unset, the server makes one on the volume (data/secret) and Settings recommends moving it
# here; with no volume mounted at the data folder it refuses to start. Keep a copy in a password manager: without it a restored database's stored keys must be entered again.
PLCOS_SECRET=
# [optional] The public address, e.g. https://raise.example.org. Normally entered in /setup; defaults to
# https://$RAILWAY_PUBLIC_DOMAIN, then the address a request came to.
PLCOS_PUBLIC_URL=
# [optional] The Google OAuth client that signs people in (openid, email, profile; no Gmail scope). Normally
# entered in /setup and kept encrypted in the app.
GOOGLE_SIGNIN_CLIENT_ID=
# [optional] secret. See GOOGLE_SIGNIN_CLIENT_ID.
GOOGLE_SIGNIN_CLIENT_SECRET=
# [optional] Other email domains a Workspace owns as aliases, comma-separated. Normally empty: a sign-in's
# address must be at the Workspace's own domain (Google's hd). Also a setting in the app.
PLCOS_SIGNIN_DOMAINS=
# [optional] How many proxies in front of the server append to X-Forwarded-For (default 1, a GUESS for
# Railway's edge until the rehearsal confirms it). Also a setting in the app.
PLCOS_TRUSTED_PROXY_HOPS=

## Database (PL's provisioned Postgres, or local Postgres on the VM fallback)

# [required] postgres://<user>@<host>:5432/<db>, with NO password in it. From the kit.
DATABASE_URL=
# [optional] secret. The database password, if the kit does not hand it over another way. The name
# the kit uses is a question for PL; libpq tools (pg_dump, psql) and node-postgres both read PGPASSWORD.
PGPASSWORD=
# [optional] Set to verify-full when the database is not on loopback. The server verifies TLS by
# itself; this makes pg_dump and psql (backup, cutover) verify it too. Preflight fails without it
# for a remote database.
PGSSLMODE=

## Connector keys (read-only connectors; the Mac copies stay in the Keychain)

# [optional] secret. Affinity API key. Entered in the app (Settings → Connections) on Railway; on the Mac it
# comes from Keychain item plcos-affinity (npm run key:store). A value here wins over the app's.
AFFINITY_API_KEY=
# [optional] secret. Linear personal key. Entered in the app on Railway; on the Mac, Keychain item
# plcos-linear / api-key. A value here wins over the app's.
LINEAR_API_KEY=
# [optional] Dakota Marketplace sign-in (Juan, 4 Oct 2026: Dakota moves to the cloud). Entered in the app
# (Settings → Connections) on Railway; on the Mac it comes from Keychain item plcos-dakota through
# scripts/with-dakota-key.sh. A value here wins over the app's. Read-only, from the Dakota workflow only.
DAKOTA_USERNAME=
# [optional] secret. See DAKOTA_USERNAME.
DAKOTA_PASSWORD=
# [never] Warehouse (Polaris) queries run from the Mac with Juan's gcloud login, not from the service.
CLOUDSDK_AUTH_ACCESS_TOKEN=

## Email drafts in each person's Gmail, through mailguard (docs/25-email-drafts.md §12)

# [optional] mailguard's origin, e.g. https://mail.example.com. Entered in Settings → Connections on Railway;
# config.email.mailguard.url is the fallback. Without it, email drafting is off and Preferences says why.
MAILGUARD_URL=
# [never] secret. Juan's mailguard key, from Keychain item plcos-claude / mailguard-token, on the Mac
# only. Each person pastes their own key in Preferences; the service needs its own token store first.
MAILGUARD_TOKEN=

## Research workflows (W1, W1c, W5 buttons)

# [optional] secret. Anthropic key from a workspace with a monthly spend limit set in the console
# (rev 3 decision 2: $1,500 a month, a GUESS). Entered in the app on Railway. Without it the buttons refuse.
ANTHROPIC_API_KEY=
# [optional] Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=

## Feedback export (the Mac dev session pulls new issues)

# [optional] secret. A random token (for example `openssl rand -hex 32`), also stored on the Mac with npm run
# secret:store. Entered in the app on Railway. Unset everywhere means GET /api/feedback/export answers 404.
FEEDBACK_EXPORT_TOKEN=

## Feedback signal (new feedback wakes the project's feedback thread, docs/deploy/04-feedback-signal.md)

# [optional] The routine's API trigger URL, https://api.anthropic.com/v1/claude_code/routines/trig_…/fire.
# Entered in the app on Railway. Unset, nothing is sent.
FEEDBACK_SIGNAL_URL=
# [optional] secret. The token claude.ai showed once when the routine's API trigger was added. Entered in the
# app on Railway. Unset, nothing is sent and GET /api/feedback/signal answers 404.
FEEDBACK_SIGNAL_TOKEN=

## Daily work and backups

# [later] HH:MM in UTC, for example 03:00. Leave unset on cutover day; set it once a manual Affinity
# sync has worked from the container (runbook §1).
SCHEDULE_DAILY_AT=
# [optional] 0 turns off the page warm-up, which re-opens the main pages over loopback once the data
# settles after a write (lib/page-warm.ts). On by default; it needs PORT, which the image sets.
PAGE_WARM=
# [required-real] Exactly: bash scripts/backup-service.sh
BACKUP_COMMAND=
# [required-real] The S3 bucket PL provides. AWS access comes from the service's role, not keys.
BACKUP_BUCKET=
# [required-real] Armored GPG PUBLIC key text (not secret). The private half stays offline with Juan.
BACKUP_GPG_PUBLIC_KEY=
# [optional] Region for the AWS CLI, if the role does not supply one. From PL.
AWS_REGION=
# [optional] secret. Only where no AWS role exists (Railway, docs/deploy/railway.md): an IAM user that can
# only put, list and delete under the bucket's plcos-* prefixes. The AWS CLI reads it; our code never does.
AWS_ACCESS_KEY_ID=
# [optional] secret. See AWS_ACCESS_KEY_ID.
AWS_SECRET_ACCESS_KEY=
# [optional] 1 = dump, verify and encrypt, print the S3 actions, make no AWS call.
BACKUP_DRY_RUN=
# [optional] With BACKUP_DRY_RUN=1: keep the encrypted files in this directory (the restore drill).
BACKUP_KEEP_DIR=

## Set by the image (Dockerfile)

# [image] production
NODE_ENV=
# [image] .next (F1)
NEXT_DIST_DIR=
# [image] 8080 unless the kit overrides it.
PORT=
# [image] The RDS CA bundle, for node.
NODE_EXTRA_CA_CERTS=
# [image] The RDS CA bundle, for libpq.
PGSSLROOTCERT=
# [image] The commit the image was built from.
GIT_COMMIT=
# [image] 1: a deployed server. It signs people in with Google and never falls back to the Mac's user
# switcher (config/sign-in.ts). Never set on the Mac, except to screenshot /setup on a demo.
PLCOS_DEPLOYED=

## Set by the platform (Railway)

# [platform] Railway's generated domain; the public address defaults to https:// it.
RAILWAY_PUBLIC_DOMAIN=
# [platform] Present on Railway: marks the server as deployed (Google sign-in), and turns on the volume check.
RAILWAY_ENVIRONMENT_ID=
# [platform] See RAILWAY_ENVIRONMENT_ID.
RAILWAY_PROJECT_ID=
# [platform] Where the volume is mounted; Settings and /setup warn unless it is /app/data.
RAILWAY_VOLUME_MOUNT_PATH=

## Set by the code itself

# [internal] Set to 1 in the import child process only.
PLCOS_IMPORT_WORKER=
# [internal] Generated per process when unset.
PLCOS_INTERNAL_ROUTING_KEY=
# [internal] Next.js.
NEXT_RUNTIME=
# [internal] Next.js.
NEXT_PHASE=

## Mac development only

# [never] Rehearsal on a copy (docs/21-postgres.md).
POSTGRES_REHEARSAL=
# [never] Preview of a real-data copy (docs/COLLAB.md).
PREVIEW_COPY_AT=
# [never] Demo PGlite folder.
PGLITE_DIR=
# [never] Research export folder override, for tests.
ENRICH_DIR=
# [never] Lets a demo server answer /api/sync/snapshot, for the snapshot round-trip test (docs/deploy/railway.md §6).
SYNC_DEMO_SNAPSHOT=
